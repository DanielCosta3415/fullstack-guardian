{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian.local/schemas/professional-contracts-v1.json",
  "title": "Guardian declared professional contracts, not measured qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_policy",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "qualification_policy": {
      "const": "DECLARED_CONTRACT_NOT_PROFESSIONAL_CERTIFICATION"
    },
    "contracts": {
      "type": "array",
      "minItems": 39,
      "maxItems": 39,
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "safe_alternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "capability",
        "when",
        "purpose",
        "safe_alternative"
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "deliver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "acceptance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "to",
        "when",
        "deliver",
        "acceptance"
      ]
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "procedure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "handoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "id",
        "when",
        "procedure",
        "acceptance",
        "handoff"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "mission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "audit",
              "build",
              "remediate",
              "explore"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d{1,2}\\.\\d{1,2}$"
              },
              "role": {
                "enum": [
                  "primary",
                  "review",
                  "extension"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ]
          }
        },
        "routing_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "procedure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "definition_of_done": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "tool_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tool"
              }
            },
            "conditional": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tool"
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tool"
              }
            },
            "empty_required_reason": {
              "type": "string"
            },
            "observation": {
              "const": "NOT_OBSERVED_BY_CONTRACT"
            }
          },
          "required": [
            "required",
            "conditional",
            "optional",
            "empty_required_reason",
            "observation"
          ]
        },
        "handoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/handoff"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "trigger": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "independence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "dependency_kind": {
              "const": "review_responsibility_not_execution_dependency"
            }
          },
          "required": [
            "reviewer",
            "trigger",
            "independence",
            "dependency_kind"
          ]
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "result_contract": {
          "const": [
            "task_id",
            "agent_id",
            "contract_version",
            "obligations",
            "artifacts",
            "facts",
            "assumptions",
            "decisions",
            "checks",
            "not_verified",
            "residual_risks",
            "handoff"
          ]
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "NOT_EVALUATED"
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "scenarios": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "evidence": {
              "const": []
            },
            "model": {
              "type": "null"
            },
            "harness_version": {
              "type": "null"
            },
            "evaluated_at": {
              "type": "null"
            },
            "expires_on_change": {
              "const": [
                "contract",
                "model",
                "harness",
                "tools",
                "environment"
              ]
            }
          },
          "required": [
            "status",
            "scope",
            "scenarios",
            "evidence",
            "model",
            "harness_version",
            "evaluated_at",
            "expires_on_change"
          ]
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          }
        }
      },
      "required": [
        "id",
        "name",
        "contract_version",
        "mission",
        "scope",
        "non_goals",
        "modes",
        "capabilities",
        "routing_terms",
        "inputs",
        "procedure",
        "artifacts",
        "definition_of_done",
        "tool_policy",
        "handoffs",
        "review",
        "stop_conditions",
        "result_contract",
        "qualification",
        "overlays"
      ]
    }
  }
}
