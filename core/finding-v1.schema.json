{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardian/finding-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "classification",
    "priority",
    "impact",
    "preconditions",
    "evidence",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "fact",
        "hypothesis",
        "style"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "info"
      ]
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
