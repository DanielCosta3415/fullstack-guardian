{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian.local/schemas/professional-result-v1.json",
  "title": "Untrusted specialist proposal, not execution attestation",
  "description": "validate_result also checks cross-references and exact task/agent/contract/obligation bindings. The supervisor must independently corroborate file contents, tool results and acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent_id",
    "contract_version",
    "obligations",
    "artifacts",
    "facts",
    "assumptions",
    "decisions",
    "checks",
    "not_verified",
    "residual_risks",
    "handoff"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "not_verified": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "status": {
          "enum": [
            "produced",
            "blocked",
            "not_verified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "alternatives",
        "rationale"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "exit_code",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 16000
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "reason"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "severity",
        "mitigation"
      ],
      "properties": {
        "risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "obligations",
        "artifacts",
        "acceptance",
        "status"
      ],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "status": {
          "enum": [
            "pending_consumer_acceptance",
            "blocked"
          ]
        }
      }
    }
  }
}
